 "Fill": "-- Turns a bar's fill image into a left-to-right fill that CROPS the texture instead of squashing\n-- it: the image is wrapped in a clipping frame at its original rect, and only the frame's width\n-- changes. Everything stays in Scale units, so it is resolution independent.\nlocal Fill = {}\n\n-- A plain table (a weak-keyed one can drop a live Instance key, and the bar would then get wrapped\n-- a second time); entries go when the clip is destroyed.\nlocal Wrapped = {}\n\n-- The clip takes over the image's NAME (the image is renamed \"Fill\"), so existing lookups such as\n-- Bar.Bar keep finding something, and Set() accepts either the clip or the image.\nfunction Fill.Wrap(Image)\n\tif Wrapped[Image] then return Wrapped[Image] end\n\tlocal Clip = Instance.new(\"Frame\")\n\tClip.Name = Image.Name\n\tImage.Name = \"Fill\"\n\tClip.BackgroundTransparency = 1\n\tClip.ClipsDescendants = true\n\tClip.ZIndex = Image.ZIndex\n\tlocal Size, Pos, Anchor = Image.Size, Image.Position, Image.AnchorPoint\n\t-- left edge of the original rect, in parent scale\n\tClip.AnchorPoint = Vector2.new(0, Anchor.Y)\n\tClip.Position = UDim2.new(Pos.X.Scale - Anchor.X * Size.X.Scale, Pos.X.Offset - Anchor.X * Size.X.Offset, Pos.Y.Scale, Pos.Y.Offset)\n\tClip.Size = Size\n\tClip.Parent = Image.Parent\n\tImage.AnchorPoint = Vector2.new(0, 0)\n\tImage.Position = UDim2.fromScale(0, 0)\n\tImage.Size = UDim2.fromScale(1, 1)\n\tImage.Parent = Clip\n\tlocal W = {Clip = Clip, Image = Image, Width = Size.X.Scale, Offset = Size.X.Offset}\n\tWrapped[Image] = W\n\tWrapped[Clip] = W\n\tClip.Destroying:Once(function() Wrapped[Image], Wrapped[Clip] = nil, nil end)\n\treturn W\nend\n\nfunction Fill.Set(Image, Ratio)\n\tlocal W = Fill.Wrap(Image)\n\tRatio = math.clamp(Ratio ~= Ratio and 0 or Ratio, 0, 1)\n\tW.Clip.Size = UDim2.new(W.Width * Ratio, W.Offset * Ratio, W.Clip.Size.Y.Scale, W.Clip.Size.Y.Offset)",
