local HS = game:GetService("HttpService")
local CS = game:GetService("CollectionService")
local CHS = game:GetService("ChangeHistoryService")
local SS = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

assert(game.PlaceId == 106992859583940, "road_cut: this is not Ye")
assert(not RunService:IsRunning(), "road_cut: Play is running; Edit only")
local Map = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Map")
local EX = Map and Map:FindFirstChild("LindenmoorExpansion")
assert(EX, "road_cut: World.Map.LindenmoorExpansion not found")
local G = EX:FindFirstChild("Ground")
assert(G, "road_cut: LindenmoorExpansion.Ground not found")

local BACKUP = "Pre-RoadCut_2026-10-24"
local FLAG = "LindenmoorRoadCut"
local NEWATTR = "LindenmoorRoadCutNew"
local FROM = "LindenmoorRoadCutFrom"
local FROMSIZE = "LindenmoorRoadCutSize"
local BASE = "LindenmoorRoadCutBase"
local FILLDIR = "RoadCutUnused"
local NOGRIP = "RenseiNoGrip"
local BUDGET = 80000 -- the place's part ceiling (Lindenmoor kit)

local OLD = HS:JSONDecode(OLD_JSON)
local NEW = HS:JSONDecode(NEW_JSON)
local COLS = HS:JSONDecode(COLS_JSON) -- road columns: {x, z, sx, sz, yaw, underside}
local EXPECT = HS:JSONDecode(EXPECT_JSON) -- changed cells: {i, j, new top}
local RETILT = HS:JSONDecode(RETILT_JSON) -- {part path, near {x, z}, top}: one end of a ribbon piece re-tilted to y top
local RAMP = HS:JSONDecode(RAMP_JSON) -- the mouth ramp slab (Ruling 35): {a, b (top line ends), width, thick, template}
local ROUTES = HS:JSONDecode(ROUTES_JSON)
local DELTA = {}
for _, e in ipairs(HS:JSONDecode(DELTA_JSON)) do
	DELTA[e[1] * 1024 + e[2]] = e[3]
end

local function cellOf(x, z)
	return math.floor((x + 1024) / 4), math.floor((z + 1024) / 4)
end
local function deltaAt(x, z)
	local i, j = cellOf(x, z)
	return DELTA[i * 1024 + j] or 0
end
local function tileName(i, j)
	return ("Ground_%d_%d"):format(i // 64, j // 64)
end
local function partName(k, i, j)
	return ("%s%d_%d"):format(k, i, j)
end
local function geom(k, i, j, w, d, a, b)
	local x0, z0 = -1024 + 4 * i, -1024 + 4 * j
	if k == "T" then
		return Vector3.new(x0 + 2 * w, a - 0.5, z0 + 2 * d), Vector3.new(4 * w, 1, 4 * d)
	end
	return Vector3.new(x0 + 2 * w, (a + b) / 2, z0 + 2 * d), Vector3.new(4 * w, b - a, 4 * d)
end

-- the median of 5 downward rays (cell centre and +-1.2 corners) against `include`; passes through parts with
-- Transparency >= 0.95; nil when fewer than 3 hit
local function topAt(include, x, z)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = include
	local ys = {}
	for _, o in ipairs({ { 0, 0 }, { 1.2, 1.2 }, { -1.2, 1.2 }, { 1.2, -1.2 }, { -1.2, -1.2 } }) do
		local from = Vector3.new(x + o[1], 600, z + o[2])
		for _ = 1, 6 do
			local r = workspace:Raycast(from, Vector3.new(0, -800, 0), rp)
			if not r then break end
			if r.Instance.Transparency < 0.95 then
				table.insert(ys, r.Position.Y)
				break
			end
			from = r.Position - Vector3.new(0, 0.01, 0)
		end
	end
	if #ys < 3 then return nil end
	table.sort(ys)
	return ys[math.ceil(#ys / 2)]
end
local function firstHit(include, x, z, fromY)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = include
	return workspace:Raycast(Vector3.new(x, fromY or 600, z), Vector3.new(0, -((fromY or 600) + 200), 0), rp)
end

local function yeRoots()
	local t = {}
	for _, n in ipairs({ "Ground", "HalvardsAdit" }) do
		if Map:FindFirstChild(n) then table.insert(t, Map[n]) end
	end
	return t
end

-- the lowest point of a model or part (world AABB)
local function minY(o)
	if o:IsA("Model") then
		local cf, size = o:GetBoundingBox()
		local e = math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z
		return cf.Position.Y - e / 2
	end
	local cf, size = o.CFrame, o.Size
	local e = math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z
	return cf.Position.Y - e / 2
end
local function pivotOf(o)
	return o:IsA("Model") and o:GetPivot() or o.CFrame
end

-- expansion objects that stand on the ground: each group's child models (a prefab: a tree, a field, a lamp...) or
-- loose parts; Markers' parts one by one (RenseiArea volumes skipped); Routes' pieces one by one (re-tilted)
-- is (x, z) under a road column's footprint?
local COLGRID = {}
for k, c in ipairs(COLS) do
	local key = math.floor(c[1] / 32) .. "," .. math.floor(c[2] / 32)
	COLGRID[key] = COLGRID[key] or {}
	table.insert(COLGRID[key], k)
end
local function colAt(x, z)
	for a = math.floor(x / 32) - 1, math.floor(x / 32) + 1 do
		for b = math.floor(z / 32) - 1, math.floor(z / 32) + 1 do
			for _, k in ipairs(COLGRID[a .. "," .. b] or {}) do
				local c = COLS[k]
				local r = math.rad(c[5])
				local dx, dz = x - c[1], z - c[2]
				local lx = dx * math.cos(r) - dz * math.sin(r)
				local lz = dx * math.sin(r) + dz * math.cos(r)
				if math.abs(lx) <= c[3] / 2 and math.abs(lz) <= c[4] / 2 then return c end
			end
		end
	end
	return nil
end
-- the road and its travel pieces are never moved; its dressing models (trees, bank stones, ridge terraces) are
local TRAVEL_FIXED = { Ground = true }
local SKIP_GROUPS = { Ground = true, SeamFillers = true, SeamRegradeFill = true, SeamPitsFill = true, Routes = true,
	Markers = true, Travel = true }
local function standingObjects()
	local out = {}
	local function add(c)
		if (c:IsA("Model") or c:IsA("BasePart")) and not c.Name:match("^RoadGate") then
			local pv = pivotOf(c)
			if not colAt(pv.X, pv.Z) then table.insert(out, c) end -- under the road: left as it is (buried under it)
		end
	end
	for _, g in ipairs(EX:GetChildren()) do
		if not SKIP_GROUPS[g.Name] then
			for _, c in ipairs(g:GetChildren()) do add(c) end
		end
	end
	local T = EX:FindFirstChild("Travel")
	local road = T and T:FindFirstChildWhichIsA("Model")
	if road then
		for _, c in ipairs(road:GetChildren()) do
			if c:IsA("Model") and not TRAVEL_FIXED[c.Name] then add(c) end
		end
	end
	local M = EX:FindFirstChild("Markers")
	if M then
		for _, d in ipairs(M:GetDescendants()) do
			if d:IsA("BasePart") and not CS:HasTag(d, "RenseiArea") then table.insert(out, d) end
		end
	end
	return out
end

-- a route piece's two ends along its long horizontal axis
local function pieceEnds(p)
	local cf, sz = p.CFrame, p.Size
	local axis, L = cf.RightVector, sz.X
	if sz.Z > sz.X then axis, L = cf.LookVector, sz.Z end
	return cf.Position - axis * (L / 2), cf.Position + axis * (L / 2), axis, L
end

local function retilt(p)
	local a, b, axis = pieceEnds(p)
	local da, db = deltaAt(a.X, a.Z), deltaAt(b.X, b.Z)
	local dc = deltaAt(p.Position.X, p.Position.Z)
	if da == 0 and db == 0 and dc == 0 then return false end
	p:SetAttribute(FROM, p.CFrame)
	local sz = p.Size
	if math.max(sz.X, sz.Z) < 6 then -- a short piece (a sleeper, a step): moves with the cell under its centre
		p.CFrame = p.CFrame + Vector3.new(0, dc, 0)
		return true
	end
	p:SetAttribute(FROMSIZE, sz)
	local a2, b2 = a + Vector3.new(0, da, 0), b + Vector3.new(0, db, 0)
	local dir2 = (b2 - a2).Unit
	local cross = axis:Cross(dir2)
	local rot = CFrame.new()
	if cross.Magnitude > 1e-6 then
		rot = CFrame.fromAxisAngle(cross.Unit, math.acos(math.clamp(axis:Dot(dir2), -1, 1)))
	end
	local r0 = p.CFrame - p.CFrame.Position
	p.CFrame = CFrame.new((a2 + b2) / 2) * rot * r0
	local L2 = (b2 - a2).Magnitude
	if sz.Z > sz.X then p.Size = Vector3.new(sz.X, sz.Y, L2) else p.Size = Vector3.new(L2, sz.Y, sz.Z) end
	return true
end

local function backupFolder(create)
	local RB = SS:FindFirstChild("RenseiBackups")
	if not RB and create then
		RB = Instance.new("Folder")
		RB.Name = "RenseiBackups"
		RB.Parent = SS
	end
	local B = RB and RB:FindFirstChild(BACKUP)
	if not B and create then
		B = Instance.new("Folder")
		B.Name = BACKUP
		B:SetAttribute("Note", "Lindenmoor road cut: the expansion ground parts it replaced (road_cut.lua undo puts them back)")
		B.Parent = RB
	end
	return B
end

-- ------------------------------------------------------------------ undo (also the rollback of a failed apply)
local function undo(strict)
	local B = backupFolder(false)
	if strict and not EX:GetAttribute(FLAG) and not B then error("road_cut undo: nothing is applied") end
	local n = { destroyed = 0, restored = 0, returned = 0 }
	for _, d in ipairs(EX:GetDescendants()) do
		if d.Parent and d:GetAttribute(NEWATTR) then
			d:Destroy()
			n.destroyed += 1
		end
	end
	if B then
		for _, p in ipairs(B:GetChildren()) do
			local ov = p:FindFirstChild("LindenmoorRoadCutParent")
			assert(ov and ov.Value, "road_cut undo: backup " .. p.Name .. " has no parent link")
			local tags = p:GetAttribute("RegionKitTags")
			if tags then
				for _, t in ipairs(HS:JSONDecode(tags)) do CS:AddTag(p, t) end
			end
			p:SetAttribute("RegionKitTags", nil)
			p:SetAttribute("LindenmoorRoadCutPath", nil)
			local parent = ov.Value
			ov:Destroy()
			p.Parent = parent
			n.restored += 1
		end
	end
	for _, d in ipairs(EX:GetDescendants()) do
		local from = d:GetAttribute(FROM)
		if from then
			if d:IsA("Model") then d:PivotTo(from) elseif d:IsA("BasePart") then d.CFrame = from end
			local sz = d:GetAttribute(FROMSIZE)
			if sz and d:IsA("BasePart") then d.Size = sz end
			d:SetAttribute(FROM, nil)
			d:SetAttribute(FROMSIZE, nil)
			d:SetAttribute(BASE, nil)
			n.returned += 1
		end
	end
	if B then B:Destroy() end
	EX:SetAttribute(FLAG, nil)
	return n
end

-- ------------------------------------------------------------------ apply
local function apply()
	if EX:GetAttribute(FLAG) then error("road_cut: already applied (" .. tostring(EX:GetAttribute(FLAG)) .. ")") end
	if backupFolder(false) then error("road_cut: the backup " .. BACKUP .. " already exists") end
	if not EX:GetAttribute("LindenmoorSeamRegrade") or not EX:GetAttribute("LindenmoorSeamPits") then
		error("road_cut: the plan sits on the seam regrade and seam_pits, which are not both applied")
	end
	if not (EX:FindFirstChild("Travel") and EX.Travel:FindFirstChildWhichIsA("Model")) then error("road_cut: no Travel road") end
	-- 1. every part to replace is where the plan says
	local olds, oldList, bad = {}, {}, {}
	for _, e in ipairs(OLD) do
		local tile = G:FindFirstChild(tileName(e[2], e[3]))
		local p = tile and tile:FindFirstChild(partName(e[1], e[2], e[3]))
		local pos, size = geom(e[1], e[2], e[3], e[4], e[5], e[6], e[7])
		if not p or not p:IsA("BasePart") or (p.Position - pos).Magnitude > 0.05 or (p.Size - size).Magnitude > 0.05 then
			if #bad < 8 then
				table.insert(bad, partName(e[1], e[2], e[3]) .. (p and (" at " .. tostring(p.Position) .. " size " .. tostring(p.Size)) or " missing"))
			end
		else
			olds[partName(e[1], e[2], e[3])] = p
			table.insert(oldList, p)
		end
	end
	if #bad > 0 then error("road_cut: replaced parts not as planned: " .. table.concat(bad, "; ")) end
	-- 2. what moves, with its base above the ground measured before the ground changes
	local moves = {}
	for _, o in ipairs(standingObjects()) do
		local pv = pivotOf(o)
		local d = deltaAt(pv.X, pv.Z)
		if d ~= 0 then
			local hit = firstHit({ G }, pv.X, pv.Z)
			table.insert(moves, { o, d, hit and (minY(o) - hit.Position.Y) or 0 })
		end
	end
	local B = backupFolder(true)
	local n = { built = 0, fill = 0, backed = 0, moved = 0, retilted = 0 }
	-- 3. new ground, cloned from the parts it replaces
	for _, e in ipairs(NEW) do
		local tpl = olds[partName(e[9], e[10], e[11])]
		assert(tpl, "road_cut: no template " .. partName(e[9], e[10], e[11]))
		local p = tpl:Clone()
		for k in pairs(p:GetAttributes()) do p:SetAttribute(k, nil) end
		local pos, size = geom(e[1], e[2], e[3], e[4], e[5], e[6], e[7])
		p.Name = partName(e[1], e[2], e[3])
		p.Size = size
		p.CFrame = CFrame.new(pos)
		if e[8] then CS:AddTag(p, NOGRIP) else CS:RemoveTag(p, NOGRIP) end
		p:SetAttribute(NEWATTR, true)
		local tn = tileName(e[2], e[3])
		local tile = G:FindFirstChild(tn)
		if not tile then
			tile = Instance.new("Model")
			tile.Name = tn
			tile:SetAttribute("RegionKit", "Lindenmoor")
			tile:SetAttribute(NEWATTR, true)
			tile.Parent = G
		end
		p.Parent = tile
		n.built += 1
	end
	-- 4. the mouth ramp (Ruling 35): a tilted slab cloned from the north road's ribbon, its top climbing from the
	-- ribbon's top (a) into the passage's first column (b)
	if RAMP.a then
		local tpl = EX
		for name in RAMP.template:gmatch("[^/]+") do tpl = tpl and tpl:FindFirstChild(name) end
		assert(tpl and tpl:IsA("BasePart"), "road_cut: no ramp template " .. RAMP.template)
		local a, b = Vector3.new(RAMP.a[1], RAMP.a[2], RAMP.a[3]), Vector3.new(RAMP.b[1], RAMP.b[2], RAMP.b[3])
		local mid = (a + b) / 2
		local cf = CFrame.lookAt(mid, b)
		local p = tpl:Clone()
		for k in pairs(p:GetAttributes()) do p:SetAttribute(k, nil) end
		p.Name = "MouthRamp"
		p.Size = Vector3.new(RAMP.width, RAMP.thick, (b - a).Magnitude)
		p.CFrame = cf - cf.UpVector * (RAMP.thick / 2)
		p:SetAttribute(NEWATTR, true)
		p.Parent = tpl.Parent
		n.ramp = 1
	end
	-- 4b. re-tilt named ribbon pieces: the end nearest `near` to top `top`, the other end where it is
	for _, e in ipairs(RETILT) do
		local p = EX
		for name in e.part:gmatch("[^/]+") do p = p and p:FindFirstChild(name) end
		assert(p and p:IsA("BasePart"), "road_cut: no part " .. e.part)
		local cf, sz = p.CFrame, p.Size
		local e1 = cf.Position - cf.LookVector * (sz.Z / 2) + cf.UpVector * (sz.Y / 2)
		local e2 = cf.Position + cf.LookVector * (sz.Z / 2) + cf.UpVector * (sz.Y / 2)
		local near = Vector3.new(e.near[1], 0, e.near[2])
		local function hd(v) return (Vector3.new(v.X, 0, v.Z) - near).Magnitude end
		if hd(e1) < hd(e2) then e1 = Vector3.new(e1.X, e.top, e1.Z) else e2 = Vector3.new(e2.X, e.top, e2.Z) end
		p:SetAttribute(FROM, cf)
		p:SetAttribute(FROMSIZE, sz)
		local look = (e2 - e1).Unit
		local mid = (e1 + e2) / 2
		local ncf = CFrame.lookAt(mid, mid + look)
		p.Size = Vector3.new(sz.X, sz.Y, (e2 - e1).Magnitude)
		p.CFrame = ncf - ncf.UpVector * (sz.Y / 2)
		n.retilted += 1
	end
	-- 5. the replaced parts go into the backup, tags stripped and kept
	for _, p in ipairs(oldList) do
		p:SetAttribute("LindenmoorRoadCutPath", p:GetFullName())
		local tags = CS:GetTags(p)
		if #tags > 0 then
			p:SetAttribute("RegionKitTags", HS:JSONEncode(tags))
			for _, t in ipairs(tags) do CS:RemoveTag(p, t) end
		end
		local ov = Instance.new("ObjectValue")
		ov.Name = "LindenmoorRoadCutParent"
		ov.Value = p.Parent
		ov.Parent = p
		p.Parent = B
		n.backed += 1
	end
	-- 6. objects follow their ground
	for _, m in ipairs(moves) do
		local o, d = m[1], m[2]
		o:SetAttribute(FROM, pivotOf(o))
		o:SetAttribute(BASE, m[3])
		if o:IsA("Model") then o:PivotTo(o:GetPivot() + Vector3.new(0, d, 0)) else o.CFrame = o.CFrame + Vector3.new(0, d, 0) end
		n.moved += 1
	end
	local R = EX:FindFirstChild("Routes")
	if R then
		for _, p in ipairs(R:GetDescendants()) do
			-- the ribbon piece under the mouth ramp (its template) stays as it is: the ramp slab covers it
			local skip = RAMP.template and p:GetFullName():sub(-#RAMP.template:gsub("/", ".")) == RAMP.template:gsub("/", ".")
			if p:IsA("BasePart") and not skip and not p:GetAttribute(NEWATTR) and not colAt(p.Position.X, p.Position.Z)
				and not p:GetAttribute(FROM) and retilt(p) then
				n.retilted += 1
			end
		end
	end
	EX:SetAttribute(FLAG, ("applied 2026-10-24 (Ruling 31): built %d, fill %d, backed up %d, moved %d, route pieces %d"):format(
		n.built, n.fill, n.backed, n.moved, n.retilted))
	return n
end

-- ------------------------------------------------------------------ checks
local function routeSteps()
	local R = EX:FindFirstChild("Routes")
	local out = { steps = 0, max = 0, where = {} }
	if not R then return out end
	for id, line in pairs(ROUTES) do
		local prev
		for k = 1, #line - 1 do
			local a, b = line[k], line[k + 1]
			local L = math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2)
			local nstep = math.max(1, math.ceil(L / 2))
			for s = 0, nstep - 1 do
				local t = s / nstep
				local x, z = a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t
				local hit = firstHit({ R }, x, z)
				local y = hit and hit.Position.Y
				if y and prev then
					local dy = math.abs(y - prev)
					if dy > 1 then
						out.steps += 1
						out.max = math.max(out.max, dy)
						if #out.where < 6 then table.insert(out.where, ("%s (%d, %d) %.1f"):format(id, x, z, dy)) end
					end
				end
				prev = y
			end
		end
	end
	return out
end

local function checks()
	local res = {}
	-- the road: every RoadPoint within 1 stud of the ground under it (the road itself excluded)
	local gnd = { G }
	for _, n in ipairs({ "Routes", "Fields", "Meadows", "SeamFillers", "SeamRegradeFill", "SeamPitsFill" }) do
		if EX:FindFirstChild(n) then table.insert(gnd, EX[n]) end
	end
	local T = EX:FindFirstChild("Travel")
	local road = T and T:FindFirstChildWhichIsA("Model")
	local rp = { points = 0, off = 0, worst = 0, where = {} }
	if road then
		for _, d in ipairs(road:GetDescendants()) do
			if d:IsA("Attachment") and d.Name == "RoadPoint" then
				local w = d.WorldPosition
				local hit = firstHit(gnd, w.X, w.Z, w.Y + 0.5)
				local e = hit and math.abs(w.Y - hit.Position.Y) or 999
				rp.points += 1
				rp.worst = math.max(rp.worst, math.floor(e * 100 + 0.5) / 100)
				if e > 1.0 then
					rp.off += 1
					if #rp.where < 8 then table.insert(rp.where, ("S %s (%.0f, %.0f) %.2f"):format(tostring(d:GetAttribute("S")), w.X, w.Z, e)) end
				end
			end
		end
	end
	res.roadPoints = rp
	-- no hollow: a ray from just under each column's underside hits ground within 0.5
	local ho = { columns = #COLS, hollow = 0, worst = 0, where = {}, inCrag = 0 }
	for _, c in ipairs(COLS) do
		local hit = firstHit(gnd, c[1], c[2], c[6] + 0.05) -- from just inside the column's bottom (the road is not in gnd)
		local gap = hit and (c[6] - hit.Position.Y) or 999
		local above = firstHit(gnd, c[1], c[2], 600)
		if above and above.Position.Y > c[6] + 0.5 and CS:HasTag(above.Instance, NOGRIP) then
			ho.inCrag += 1 -- the road's end runs into the crag (the tunnel mouth): the column is inside the wall
		elseif gap > 0.5 then
			ho.hollow += 1
			ho.worst = math.max(ho.worst, math.floor(gap * 100 + 0.5) / 100)
			if #ho.where < 8 then table.insert(ho.where, ("(%.0f, %.0f) %.2f"):format(c[1], c[2], gap)) end
		end
	end
	res.hollows = ho
	-- the built ground tops are the planned ones
	local mis, mwhere = 0, {}
	for _, e in ipairs(EXPECT) do
		local x, z = -1024 + 4 * e[1] + 2, -1024 + 4 * e[2] + 2
		local y = topAt({ G }, x, z)
		if not y or math.abs(y - e[3]) > 0.05 then
			mis += 1
			if #mwhere < 6 then table.insert(mwhere, ("(%d, %d) %s vs %d"):format(x, z, tostring(y), e[3])) end
		end
	end
	res.tops = { cells = #EXPECT, mismatched = mis, where = mwhere }
	-- walk the north road's centreline from inside the village into the passage (and on along it): the first solid
	-- surface every stud, overhead parts (the gate's lintel, canopies: more than 6 above the last step) passed through
	local line = { { 0, -330 }, { 0, -296 }, { 0, -150 }, { 60, -60 }, { 200, 80 }, { 380, 260 }, { 560, 480 }, { 700, 680 },
		{ 790, 860 }, { 806, 938 } }
	local wp = RaycastParams.new()
	wp.FilterType = Enum.RaycastFilterType.Exclude
	local chars = {}
	for _, pl in ipairs(game:GetService("Players"):GetPlayers()) do if pl.Character then table.insert(chars, pl.Character) end end
	wp.FilterDescendantsInstances = chars
	local walk = { samples = 0, steps = 0, max = 0, where = {}, mouth = {} }
	local prev
	for k = 1, #line - 1 do
		local a, b = line[k], line[k + 1]
		local L = math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2)
		for st = 0, math.ceil(L) - 1 do
			local t = st / L
			local x, z = a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t
			local from, y, what = Vector3.new(x, 300, z), nil, nil
			for _ = 1, 12 do
				local r = workspace:Raycast(from, Vector3.new(0, -400, 0), wp)
				if not r then break end
				local i = r.Instance
				if i.CanCollide and i.Transparency < 0.95 and (not prev or r.Position.Y <= prev + 6) then
					y, what = r.Position.Y, i
					break
				end
				from = r.Position - Vector3.new(0, 0.01, 0)
			end
			if y then
				walk.samples += 1
				if x > 640 and x < 700 and #walk.mouth < 40 and st % 2 == 0 then
					table.insert(walk.mouth, ("%.0f,%.0f %.1f"):format(x, z, y))
				end
				if prev and math.abs(y - prev) > 1.0 then
					walk.steps += 1
					walk.max = math.max(walk.max, math.floor(math.abs(y - prev) * 100 + 0.5) / 100)
					if #walk.where < 10 then
						table.insert(walk.where, ("(%.0f, %.0f) %.1f -> %.1f %s"):format(x, z, prev, y,
							what:GetFullName():gsub("Workspace.World.Map.", "")))
					end
				end
				prev = y
			end
		end
	end
	res.walk = walk
	-- bare Baseplate: every 4-stud point whose first solid hit is the Baseplate (or nothing)
	local bp = Map:FindFirstChild("Baseplate")
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {}
	local vis, sample = 0, {}
	for x = -1022, 1022, 4 do
		for z = -1022, 1022, 4 do
			local from, r = Vector3.new(x, 600, z), nil
			for _ = 1, 8 do
				r = workspace:Raycast(from, Vector3.new(0, -700, 0), rp)
				if not r then break end
				local inst = r.Instance
				if inst:IsA("BasePart") and inst ~= bp and (inst.Transparency >= 0.95 or not inst.CanCollide) then
					from = r.Position - Vector3.new(0, 0.01, 0)
				else
					break
				end
			end
			if not r or r.Instance == bp then
				vis += 1
				if #sample < 10 then table.insert(sample, ("%d,%d"):format(x, z)) end
			end
		end
	end
	res.baseplateVisible = vis
	res.baseplateSample = sample
	-- moved objects: base vs the ground under them, against the same offset before the move
	local cnt, off, worstOff, where = 0, 0, 0, {}
	for _, d in ipairs(EX:GetDescendants()) do
		local b0 = d:GetAttribute(BASE)
		if b0 then
			cnt += 1
			local pv = pivotOf(d)
			local hit = firstHit({ G }, pv.X, pv.Z)
			local b1 = hit and (minY(d) - hit.Position.Y) or 0
			local e = math.abs(b1 - b0)
			worstOff = math.max(worstOff, e)
			if e > 0.5 then
				off += 1
				if #where < 6 then table.insert(where, ("%s %.1f"):format(d:GetFullName():gsub("Workspace.World.Map.LindenmoorExpansion.", ""), e)) end
			end
		end
	end
	res.moved = { checked = cnt, offOver05 = off, worst = math.floor(worstOff * 100 + 0.5) / 100, where = where }
	-- part count
	local parts = 0
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("BasePart") and not d:IsA("Terrain") then parts += 1 end
	end
	res.parts = parts
	res.withinBudget = parts <= BUDGET
	res.routes = routeSteps()
	return res
end

-- ------------------------------------------------------------------ snapshot (test mode)
local function snapshot()
	local rows = {}
	local function r3(v) return math.floor(v * 1000 + 0.5) / 1000 end
	local function attrs(d)
		local ks = {}
		for k, v in pairs(d:GetAttributes()) do table.insert(ks, k .. "=" .. tostring(v)) end
		table.sort(ks)
		local tags = CS:GetTags(d)
		table.sort(tags)
		return table.concat(ks, ";") .. "#" .. table.concat(tags, ";")
	end
	for _, d in ipairs(EX:GetDescendants()) do
		local s = d:GetFullName() .. "|" .. d.ClassName
		if d:IsA("BasePart") then
			local c = { d.CFrame:GetComponents() }
			for k = 1, 12 do c[k] = r3(c[k]) end
			s ..= "|" .. table.concat(c, ",") .. "|" .. r3(d.Size.X) .. "," .. r3(d.Size.Y) .. "," .. r3(d.Size.Z) .. "|"
				.. d.Material.Name .. "|" .. d.Color:ToHex() .. "|" .. d.MaterialVariant
		elseif d:IsA("Model") then
			local c = { d:GetPivot():GetComponents() }
			for k = 1, 12 do c[k] = r3(c[k]) end
			s ..= "|" .. table.concat(c, ",")
		end
		table.insert(rows, s .. "|" .. attrs(d))
	end
	table.sort(rows)
	return rows
end
local function compare(a, b)
	local diffs, first = 0, {}
	local i, j = 1, 1
	while i <= #a or j <= #b do
		if a[i] == b[j] then
			i += 1
			j += 1
		else
			diffs += 1
			if #first < 4 then table.insert(first, (a[i] or "-") .. "  VS  " .. (b[j] or "-")) end
			if (a[i] or "~") < (b[j] or "~") then i += 1 else j += 1 end
		end
	end
	return diffs, first
end

-- ------------------------------------------------------------------ run
local function recorded(fn)
	local rec = CHS:TryBeginRecording("LindenmoorRoadCut")
	local ok, res = pcall(fn)
	if rec then CHS:FinishRecording(rec, ok and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel) end
	return ok, res
end

local out = { mode = MODE }
if MODE == "apply" then
	local ok, res = recorded(function()
		local okA, n = pcall(apply)
		if not okA then
			local okU, u = pcall(undo, false)
			error("apply failed and was rolled back (" .. (okU and HS:JSONEncode(u) or ("rollback ALSO failed: " .. tostring(u))) .. "): " .. tostring(n))
		end
		return n
	end)
	if not ok then return "road_cut apply FAILED: " .. tostring(res) end
	out.applied = res
	out.checks = checks()
elseif MODE == "undo" then
	local ok, res = recorded(function() return undo(true) end)
	if not ok then return "road_cut undo FAILED: " .. tostring(res) end
	out.undone = res
	local left = 0
	for _, d in ipairs(EX:GetDescendants()) do
		if d:GetAttribute(NEWATTR) or d:GetAttribute(FROM) then left += 1 end
	end
	out.leftover = left
	out.backup = backupFolder(false) ~= nil
elseif MODE == "check" then
	out.applied = EX:GetAttribute(FLAG)
	out.checks = checks()
elseif MODE == "test" then
	if EX:GetAttribute(FLAG) then return "road_cut test: refuses, the regrade is applied" end
	local before = snapshot()
	local baseCount = #before
	local preRoutes = routeSteps()
	local ok, res = pcall(apply)
	if not ok then
		pcall(undo, false)
		return "road_cut test: apply FAILED (rolled back): " .. tostring(res)
	end
	out.applied = res
	out.checks = checks()
	out.routesBefore = preRoutes
	local okU, u = pcall(undo, true)
	out.undone = okU and u or ("FAILED: " .. tostring(u))
	local after = snapshot()
	local diffs, first = compare(before, after)
	out.snapshot = { before = baseCount, after = #after, diffs = diffs, first = first, equal = diffs == 0 }
	out.backupLeft = backupFolder(false) ~= nil
else
	error("road_cut: unknown MODE " .. tostring(MODE))
end
return HS:JSONEncode(out)
