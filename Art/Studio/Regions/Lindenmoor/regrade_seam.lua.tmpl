local HS = game:GetService("HttpService")
local CS = game:GetService("CollectionService")
local CHS = game:GetService("ChangeHistoryService")
local SS = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

assert(game.PlaceId == 106992859583940, "regrade_seam: this is not Ye")
assert(not RunService:IsRunning(), "regrade_seam: Play is running; Edit only")
local Map = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Map")
local EX = Map and Map:FindFirstChild("LindenmoorExpansion")
assert(EX, "regrade_seam: World.Map.LindenmoorExpansion not found")
local G = EX:FindFirstChild("Ground")
assert(G, "regrade_seam: LindenmoorExpansion.Ground not found")

local BACKUP = "Pre-SeamRegrade_2026-10-24"
local FLAG = "LindenmoorSeamRegrade"
local NEWATTR = "LindenmoorSeamNew"
local FROM = "LindenmoorSeamFrom"
local FROMSIZE = "LindenmoorSeamSize"
local BASE = "LindenmoorSeamBase"
local FILLDIR = "SeamRegradeFill"
local NOGRIP = "RenseiNoGrip"
local BUDGET = 80000 -- the place's part ceiling (Lindenmoor kit)

local OLD = HS:JSONDecode(OLD_JSON)
local NEW = HS:JSONDecode(NEW_JSON)
local PAIRS = HS:JSONDecode(PAIRS_JSON)
local FILL = HS:JSONDecode(FILL_JSON)
local ROUTES = HS:JSONDecode(ROUTES_JSON)
local DELTA = {}
for _, e in ipairs(HS:JSONDecode(DELTA_JSON)) do
	DELTA[e[1] * 1024 + e[2]] = e[3]
end

local function cellOf(x, z)
	return math.floor((x + 1024) / 4), math.floor((z + 1024) / 4)
end
local function deltaAt(x, z)
	local i, j = cellOf(x, z)
	return DELTA[i * 1024 + j] or 0
end
local function tileName(i, j)
	return ("Ground_%d_%d"):format(i // 64, j // 64)
end
local function partName(k, i, j)
	return ("%s%d_%d"):format(k, i, j)
end
local function geom(k, i, j, w, d, a, b)
	local x0, z0 = -1024 + 4 * i, -1024 + 4 * j
	if k == "T" then
		return Vector3.new(x0 + 2 * w, a - 0.5, z0 + 2 * d), Vector3.new(4 * w, 1, 4 * d)
	end
	return Vector3.new(x0 + 2 * w, (a + b) / 2, z0 + 2 * d), Vector3.new(4 * w, b - a, 4 * d)
end

-- the median of 5 downward rays (cell centre and +-1.2 corners) against `include`; passes through parts with
-- Transparency >= 0.95; nil when fewer than 3 hit
local function topAt(include, x, z)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = include
	local ys = {}
	for _, o in ipairs({ { 0, 0 }, { 1.2, 1.2 }, { -1.2, 1.2 }, { 1.2, -1.2 }, { -1.2, -1.2 } }) do
		local from = Vector3.new(x + o[1], 600, z + o[2])
		for _ = 1, 6 do
			local r = workspace:Raycast(from, Vector3.new(0, -800, 0), rp)
			if not r then break end
			if r.Instance.Transparency < 0.95 then
				table.insert(ys, r.Position.Y)
				break
			end
			from = r.Position - Vector3.new(0, 0.01, 0)
		end
	end
	if #ys < 3 then return nil end
	table.sort(ys)
	return ys[math.ceil(#ys / 2)]
end
local function firstHit(include, x, z, fromY)
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = include
	return workspace:Raycast(Vector3.new(x, fromY or 600, z), Vector3.new(0, -((fromY or 600) + 200), 0), rp)
end

local function yeRoots()
	local t = {}
	for _, n in ipairs({ "Ground", "HalvardsAdit" }) do
		if Map:FindFirstChild(n) then table.insert(t, Map[n]) end
	end
	return t
end

-- the lowest point of a model or part (world AABB)
local function minY(o)
	if o:IsA("Model") then
		local cf, size = o:GetBoundingBox()
		local e = math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z
		return cf.Position.Y - e / 2
	end
	local cf, size = o.CFrame, o.Size
	local e = math.abs(cf.RightVector.Y) * size.X + math.abs(cf.UpVector.Y) * size.Y + math.abs(cf.LookVector.Y) * size.Z
	return cf.Position.Y - e / 2
end
local function pivotOf(o)
	return o:IsA("Model") and o:GetPivot() or o.CFrame
end

-- expansion objects that stand on the ground: each group's child models (a prefab: a tree, a field, a lamp...) or
-- loose parts; Markers' parts one by one (RenseiArea volumes skipped); Routes' pieces one by one (re-tilted)
local SKIP_GROUPS = { Ground = true, SeamFillers = true, [FILLDIR] = true, Routes = true, Markers = true }
local function standingObjects()
	local out = {}
	for _, g in ipairs(EX:GetChildren()) do
		if not SKIP_GROUPS[g.Name] then
			for _, c in ipairs(g:GetChildren()) do
				if c:IsA("Model") or c:IsA("BasePart") then table.insert(out, c) end
			end
		end
	end
	local M = EX:FindFirstChild("Markers")
	if M then
		for _, d in ipairs(M:GetDescendants()) do
			if d:IsA("BasePart") and not CS:HasTag(d, "RenseiArea") then table.insert(out, d) end
		end
	end
	return out
end

-- a route piece's two ends along its long horizontal axis
local function pieceEnds(p)
	local cf, sz = p.CFrame, p.Size
	local axis, L = cf.RightVector, sz.X
	if sz.Z > sz.X then axis, L = cf.LookVector, sz.Z end
	return cf.Position - axis * (L / 2), cf.Position + axis * (L / 2), axis, L
end

local function retilt(p)
	local a, b, axis = pieceEnds(p)
	local da, db = deltaAt(a.X, a.Z), deltaAt(b.X, b.Z)
	local dc = deltaAt(p.Position.X, p.Position.Z)
	if da == 0 and db == 0 and dc == 0 then return false end
	p:SetAttribute(FROM, p.CFrame)
	local sz = p.Size
	if math.max(sz.X, sz.Z) < 6 then -- a short piece (a sleeper, a step): moves with the cell under its centre
		p.CFrame = p.CFrame + Vector3.new(0, dc, 0)
		return true
	end
	p:SetAttribute(FROMSIZE, sz)
	local a2, b2 = a + Vector3.new(0, da, 0), b + Vector3.new(0, db, 0)
	local dir2 = (b2 - a2).Unit
	local cross = axis:Cross(dir2)
	local rot = CFrame.new()
	if cross.Magnitude > 1e-6 then
		rot = CFrame.fromAxisAngle(cross.Unit, math.acos(math.clamp(axis:Dot(dir2), -1, 1)))
	end
	local r0 = p.CFrame - p.CFrame.Position
	p.CFrame = CFrame.new((a2 + b2) / 2) * rot * r0
	local L2 = (b2 - a2).Magnitude
	if sz.Z > sz.X then p.Size = Vector3.new(sz.X, sz.Y, L2) else p.Size = Vector3.new(L2, sz.Y, sz.Z) end
	return true
end

local function backupFolder(create)
	local RB = SS:FindFirstChild("RenseiBackups")
	if not RB and create then
		RB = Instance.new("Folder")
		RB.Name = "RenseiBackups"
		RB.Parent = SS
	end
	local B = RB and RB:FindFirstChild(BACKUP)
	if not B and create then
		B = Instance.new("Folder")
		B.Name = BACKUP
		B:SetAttribute("Note", "Lindenmoor seam regrade: the expansion ground parts it replaced (regrade_seam.lua undo puts them back)")
		B.Parent = RB
	end
	return B
end

-- ------------------------------------------------------------------ undo (also the rollback of a failed apply)
local function undo(strict)
	local B = backupFolder(false)
	if strict then -- fixes applied after the regrade, on top of it (the gorge fix: final review I2)
		local later = {}
		for _, a in ipairs({ "LindenmoorRoadCut", "LindenmoorSeamPits", "LindenmoorGorgeFix" }) do
			if EX:GetAttribute(a) then table.insert(later, a) end
		end
		if #later > 0 then
			error("regrade_seam undo: still applied: " .. table.concat(later, ", ")
				.. "; undo those first (rollback order: road_cut, bed_fix bedundo, seam_pits, gorge_fix, then regrade_seam)")
		end
	end
	if strict and not EX:GetAttribute(FLAG) and not B then error("regrade_seam undo: nothing is applied") end
	local n = { destroyed = 0, restored = 0, returned = 0 }
	for _, d in ipairs(EX:GetDescendants()) do
		if d.Parent and d:GetAttribute(NEWATTR) then
			d:Destroy()
			n.destroyed += 1
		end
	end
	if B then
		for _, p in ipairs(B:GetChildren()) do
			local ov = p:FindFirstChild("LindenmoorSeamParent")
			assert(ov and ov.Value, "regrade_seam undo: backup " .. p.Name .. " has no parent link")
			local tags = p:GetAttribute("RegionKitTags")
			if tags then
				for _, t in ipairs(HS:JSONDecode(tags)) do CS:AddTag(p, t) end
			end
			p:SetAttribute("RegionKitTags", nil)
			p:SetAttribute("LindenmoorSeamPath", nil)
			local parent = ov.Value
			ov:Destroy()
			p.Parent = parent
			n.restored += 1
		end
	end
	for _, d in ipairs(EX:GetDescendants()) do
		local from = d:GetAttribute(FROM)
		if from then
			if d:IsA("Model") then d:PivotTo(from) elseif d:IsA("BasePart") then d.CFrame = from end
			local sz = d:GetAttribute(FROMSIZE)
			if sz and d:IsA("BasePart") then d.Size = sz end
			d:SetAttribute(FROM, nil)
			d:SetAttribute(FROMSIZE, nil)
			d:SetAttribute(BASE, nil)
			n.returned += 1
		end
	end
	if B then B:Destroy() end
	EX:SetAttribute(FLAG, nil)
	return n
end

-- ------------------------------------------------------------------ apply
local function apply()
	if EX:GetAttribute(FLAG) then error("regrade_seam: already applied (" .. tostring(EX:GetAttribute(FLAG)) .. ")") end
	if backupFolder(false) then error("regrade_seam: the backup " .. BACKUP .. " already exists") end
	-- 1. every part to replace is where the plan says
	local olds, oldList, bad = {}, {}, {}
	for _, e in ipairs(OLD) do
		local tile = G:FindFirstChild(tileName(e[2], e[3]))
		local p = tile and tile:FindFirstChild(partName(e[1], e[2], e[3]))
		local pos, size = geom(e[1], e[2], e[3], e[4], e[5], e[6], e[7])
		if not p or not p:IsA("BasePart") or (p.Position - pos).Magnitude > 0.05 or (p.Size - size).Magnitude > 0.05 then
			if #bad < 8 then
				table.insert(bad, partName(e[1], e[2], e[3]) .. (p and (" at " .. tostring(p.Position) .. " size " .. tostring(p.Size)) or " missing"))
			end
		else
			olds[partName(e[1], e[2], e[3])] = p
			table.insert(oldList, p)
		end
	end
	if #bad > 0 then error("regrade_seam: replaced parts not as planned: " .. table.concat(bad, "; ")) end
	-- 2. what moves, with its base above the ground measured before the ground changes
	local moves = {}
	for _, o in ipairs(standingObjects()) do
		local pv = pivotOf(o)
		local d = deltaAt(pv.X, pv.Z)
		if d ~= 0 then
			local hit = firstHit({ G }, pv.X, pv.Z)
			table.insert(moves, { o, d, hit and (minY(o) - hit.Position.Y) or 0 })
		end
	end
	local B = backupFolder(true)
	local n = { built = 0, fill = 0, backed = 0, moved = 0, retilted = 0 }
	-- 3. new ground, cloned from the parts it replaces
	for _, e in ipairs(NEW) do
		local tpl = olds[partName(e[9], e[10], e[11])]
		assert(tpl, "regrade_seam: no template " .. partName(e[9], e[10], e[11]))
		local p = tpl:Clone()
		for k in pairs(p:GetAttributes()) do p:SetAttribute(k, nil) end
		local pos, size = geom(e[1], e[2], e[3], e[4], e[5], e[6], e[7])
		p.Name = partName(e[1], e[2], e[3])
		p.Size = size
		p.CFrame = CFrame.new(pos)
		if e[8] then CS:AddTag(p, NOGRIP) else CS:RemoveTag(p, NOGRIP) end
		p:SetAttribute(NEWATTR, true)
		local tn = tileName(e[2], e[3])
		local tile = G:FindFirstChild(tn)
		if not tile then
			tile = Instance.new("Model")
			tile.Name = tn
			tile:SetAttribute("RegionKit", "Lindenmoor")
			tile:SetAttribute(NEWATTR, true)
			tile.Parent = G
		end
		p.Parent = tile
		n.built += 1
	end
	-- 4. bare-Baseplate cover over Ye's sunken edge cells, cloned from the Ye part there
	if #FILL > 0 then
		local fd = Instance.new("Folder")
		fd.Name = FILLDIR
		fd:SetAttribute(NEWATTR, true)
		fd:SetAttribute("SeamFiller", "Lindenmoor seam regrade: 1-stud covers over Ye edge cells whose top is below the Baseplate")
		fd.Parent = EX
		for _, e in ipairs(FILL) do
			local x0, z0 = -1024 + 4 * e[1], -1024 + 4 * e[2]
			local hit = firstHit(yeRoots(), x0 + 2, z0 + 2)
			assert(hit and hit.Instance:IsA("BasePart"), ("regrade_seam: no Ye part at fill cell %d, %d"):format(x0, z0))
			local p = hit.Instance:Clone()
			p:ClearAllChildren()
			for _, t in ipairs(CS:GetTags(p)) do CS:RemoveTag(p, t) end
			for k in pairs(p:GetAttributes()) do p:SetAttribute(k, nil) end
			p.Name = ("Fill%d_%d"):format(e[1], e[2])
			p.Size = Vector3.new(4 * e[3], 1, 4 * e[4])
			p.CFrame = CFrame.new(x0 + 2 * e[3], 0.5, z0 + 2 * e[4])
			p.Anchored = true
			p.CanCollide = true
			p.Transparency = 0
			p:SetAttribute(NEWATTR, true)
			p.Parent = fd
			n.fill += 1
		end
	end
	-- 5. the replaced parts go into the backup, tags stripped and kept
	for _, p in ipairs(oldList) do
		p:SetAttribute("LindenmoorSeamPath", p:GetFullName())
		local tags = CS:GetTags(p)
		if #tags > 0 then
			p:SetAttribute("RegionKitTags", HS:JSONEncode(tags))
			for _, t in ipairs(tags) do CS:RemoveTag(p, t) end
		end
		local ov = Instance.new("ObjectValue")
		ov.Name = "LindenmoorSeamParent"
		ov.Value = p.Parent
		ov.Parent = p
		p.Parent = B
		n.backed += 1
	end
	-- 6. objects follow their ground
	for _, m in ipairs(moves) do
		local o, d = m[1], m[2]
		o:SetAttribute(FROM, pivotOf(o))
		o:SetAttribute(BASE, m[3])
		if o:IsA("Model") then o:PivotTo(o:GetPivot() + Vector3.new(0, d, 0)) else o.CFrame = o.CFrame + Vector3.new(0, d, 0) end
		n.moved += 1
	end
	local R = EX:FindFirstChild("Routes")
	if R then
		for _, p in ipairs(R:GetDescendants()) do
			if p:IsA("BasePart") and retilt(p) then n.retilted += 1 end
		end
	end
	EX:SetAttribute(FLAG, ("applied 2026-10-24: built %d, fill %d, backed up %d, moved %d, route pieces %d"):format(
		n.built, n.fill, n.backed, n.moved, n.retilted))
	return n
end

-- ------------------------------------------------------------------ checks
local function routeSteps()
	local R = EX:FindFirstChild("Routes")
	local out = { steps = 0, max = 0, where = {} }
	if not R then return out end
	for id, line in pairs(ROUTES) do
		local prev
		for k = 1, #line - 1 do
			local a, b = line[k], line[k + 1]
			local L = math.sqrt((b[1] - a[1]) ^ 2 + (b[2] - a[2]) ^ 2)
			local nstep = math.max(1, math.ceil(L / 2))
			for s = 0, nstep - 1 do
				local t = s / nstep
				local x, z = a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t
				local hit = firstHit({ R }, x, z)
				local y = hit and hit.Position.Y
				if y and prev then
					local dy = math.abs(y - prev)
					if dy > 1 then
						out.steps += 1
						out.max = math.max(out.max, dy)
						if #out.where < 6 then table.insert(out.where, ("%s (%d, %d) %.1f"):format(id, x, z, dy)) end
					end
				end
				prev = y
			end
		end
	end
	return out
end

local function checks()
	local res = {}
	-- boundary jumps
	local yeInc = yeRoots()
	if EX:FindFirstChild(FILLDIR) then table.insert(yeInc, EX[FILLDIR]) end
	local by, worst, unmeasured, unexcused = {}, 0, 0, {}
	for _, e in ipairs(PAIRS) do
		local yy = topAt(yeInc, e[1] + 2, e[2] + 2)
		local ny = topAt({ G }, e[4] + 2, e[5] + 2)
		if not yy or not ny then
			unmeasured += 1
		else
			local cls = e[6] == "" and "none" or e[6]
			local b = by[cls] or { pairs = 0, over1 = 0, max = 0 }
			by[cls] = b
			local j = math.abs(ny - yy)
			b.pairs += 1
			b.max = math.max(b.max, math.floor(j * 10 + 0.5) / 10)
			if j > 1.05 then b.over1 += 1 end
			if cls == "none" then
				worst = math.max(worst, j)
				if j > 1.05 and #unexcused < 20 then
					table.insert(unexcused, ("ye(%d,%d)=%.1f new(%d,%d)=%.1f"):format(e[1], e[2], yy, e[4], e[5], ny))
				end
			end
		end
	end
	res.jumps = { byClass = by, worstUnexcused = math.floor(worst * 10 + 0.5) / 10, unmeasured = unmeasured,
		unexcused = unexcused }
	-- bare Baseplate: every 4-stud point whose first solid hit is the Baseplate (or nothing)
	local bp = Map:FindFirstChild("Baseplate")
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	rp.FilterDescendantsInstances = {}
	local vis, sample = 0, {}
	for x = -1022, 1022, 4 do
		for z = -1022, 1022, 4 do
			local from, r = Vector3.new(x, 600, z), nil
			for _ = 1, 8 do
				r = workspace:Raycast(from, Vector3.new(0, -700, 0), rp)
				if not r then break end
				local inst = r.Instance
				if inst:IsA("BasePart") and inst ~= bp and (inst.Transparency >= 0.95 or not inst.CanCollide) then
					from = r.Position - Vector3.new(0, 0.01, 0)
				else
					break
				end
			end
			if not r or r.Instance == bp then
				vis += 1
				if #sample < 10 then table.insert(sample, ("%d,%d"):format(x, z)) end
			end
		end
	end
	res.baseplateVisible = vis
	res.baseplateSample = sample
	-- moved objects: base vs the ground under them, against the same offset before the move
	local cnt, off, worstOff, where = 0, 0, 0, {}
	for _, d in ipairs(EX:GetDescendants()) do
		local b0 = d:GetAttribute(BASE)
		if b0 then
			cnt += 1
			local pv = pivotOf(d)
			local hit = firstHit({ G }, pv.X, pv.Z)
			local b1 = hit and (minY(d) - hit.Position.Y) or 0
			local e = math.abs(b1 - b0)
			worstOff = math.max(worstOff, e)
			if e > 0.5 then
				off += 1
				if #where < 6 then table.insert(where, ("%s %.1f"):format(d:GetFullName():gsub("Workspace.World.Map.LindenmoorExpansion.", ""), e)) end
			end
		end
	end
	res.moved = { checked = cnt, offOver05 = off, worst = math.floor(worstOff * 100 + 0.5) / 100, where = where }
	-- part count
	local parts = 0
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("BasePart") and not d:IsA("Terrain") then parts += 1 end
	end
	res.parts = parts
	res.withinBudget = parts <= BUDGET
	res.routes = routeSteps()
	return res
end

-- ------------------------------------------------------------------ snapshot (test mode)
local function snapshot()
	local rows = {}
	local function r3(v) return math.floor(v * 1000 + 0.5) / 1000 end
	local function attrs(d)
		local ks = {}
		for k, v in pairs(d:GetAttributes()) do table.insert(ks, k .. "=" .. tostring(v)) end
		table.sort(ks)
		local tags = CS:GetTags(d)
		table.sort(tags)
		return table.concat(ks, ";") .. "#" .. table.concat(tags, ";")
	end
	for _, d in ipairs(EX:GetDescendants()) do
		local s = d:GetFullName() .. "|" .. d.ClassName
		if d:IsA("BasePart") then
			local c = { d.CFrame:GetComponents() }
			for k = 1, 12 do c[k] = r3(c[k]) end
			s ..= "|" .. table.concat(c, ",") .. "|" .. r3(d.Size.X) .. "," .. r3(d.Size.Y) .. "," .. r3(d.Size.Z) .. "|"
				.. d.Material.Name .. "|" .. d.Color:ToHex() .. "|" .. d.MaterialVariant
		elseif d:IsA("Model") then
			local c = { d:GetPivot():GetComponents() }
			for k = 1, 12 do c[k] = r3(c[k]) end
			s ..= "|" .. table.concat(c, ",")
		end
		table.insert(rows, s .. "|" .. attrs(d))
	end
	table.sort(rows)
	return rows
end
local function compare(a, b)
	local diffs, first = 0, {}
	local i, j = 1, 1
	while i <= #a or j <= #b do
		if a[i] == b[j] then
			i += 1
			j += 1
		else
			diffs += 1
			if #first < 4 then table.insert(first, (a[i] or "-") .. "  VS  " .. (b[j] or "-")) end
			if (a[i] or "~") < (b[j] or "~") then i += 1 else j += 1 end
		end
	end
	return diffs, first
end

-- ------------------------------------------------------------------ run
local function recorded(fn)
	local rec = CHS:TryBeginRecording("LindenmoorSeamRegrade")
	local ok, res = pcall(fn)
	if rec then CHS:FinishRecording(rec, ok and Enum.FinishRecordingOperation.Commit or Enum.FinishRecordingOperation.Cancel) end
	return ok, res
end

local out = { mode = MODE }
if MODE == "apply" then
	local ok, res = recorded(function()
		local okA, n = pcall(apply)
		if not okA then
			local okU, u = pcall(undo, false)
			error("apply failed and was rolled back (" .. (okU and HS:JSONEncode(u) or ("rollback ALSO failed: " .. tostring(u))) .. "): " .. tostring(n))
		end
		return n
	end)
	if not ok then return "regrade_seam apply FAILED: " .. tostring(res) end
	out.applied = res
	out.checks = checks()
elseif MODE == "undo" then
	local ok, res = recorded(function() return undo(true) end)
	if not ok then return "regrade_seam undo FAILED: " .. tostring(res) end
	out.undone = res
	local left = 0
	for _, d in ipairs(EX:GetDescendants()) do
		if d:GetAttribute(NEWATTR) or d:GetAttribute(FROM) then left += 1 end
	end
	out.leftover = left
	out.backup = backupFolder(false) ~= nil
elseif MODE == "check" then
	out.applied = EX:GetAttribute(FLAG)
	out.checks = checks()
elseif MODE == "test" then
	if EX:GetAttribute(FLAG) then return "regrade_seam test: refuses, the regrade is applied" end
	local before = snapshot()
	local baseCount = #before
	local preRoutes = routeSteps()
	local ok, res = pcall(apply)
	if not ok then
		pcall(undo, false)
		return "regrade_seam test: apply FAILED (rolled back): " .. tostring(res)
	end
	out.applied = res
	out.checks = checks()
	out.routesBefore = preRoutes
	local okU, u = pcall(undo, true)
	out.undone = okU and u or ("FAILED: " .. tostring(u))
	local after = snapshot()
	local diffs, first = compare(before, after)
	out.snapshot = { before = baseCount, after = #after, diffs = diffs, first = first, equal = diffs == 0 }
	out.backupLeft = backupFolder(false) ~= nil
else
	error("regrade_seam: unknown MODE " .. tostring(MODE))
end
return HS:JSONEncode(out)
