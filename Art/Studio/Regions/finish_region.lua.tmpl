-- generated by Art/Studio/Regions/kit.py from finish_region.lua.tmpl ({{DATE}}): do not edit by hand.
-- Region {{REGION}} (place {{PLACE_ID}}). Run in Studio Edit after import/chunk_NN.lua have built ServerStorage.RegionStaging.
--   * DryRun: RegionStaging:SetAttribute("DryRun", true) first. Checks the staging against expected.json (models,
--     parts, groups, tags, RegionKit, the texture-pack MaterialVariants), then removes the staging folder and every
--     MaterialVariant the chunks made (RegionKitStaged = Region), so the place is left as it was. Returns
--     "dry run ok: ..." or "dry run FAILED: ...".
--   * Otherwise (the real run, only in place {{PLACE_ID}}): refuses if RenseiBackups["Pre-Region_{{REGION}}_{{DATE}}"]
--     exists; creates it; moves every workspace.World.Map child into it (except KEEP); backs up any MaterialVariant
--     it replaces; parents the staged groups under workspace.World.Map.{{REGION}}; fills the terrain water boxes
--     (water.json); returns a summary.
local HS = game:GetService("HttpService")
local SS = game:GetService("ServerStorage")
local MS = game:GetService("MaterialService")
local CS = game:GetService("CollectionService")

local REGION, PLACE_ID, DATE = "{{REGION}}", {{PLACE_ID}}, "{{DATE}}"
local EXPECTED = HS:JSONDecode([==[{{EXPECTED}}]==])
local WATER = HS:JSONDecode([==[{{WATER}}]==]) -- {Rect = {x0, z0, x1, z1}, Top, Bed} in region coordinates
local ORIGIN = Vector3.new({{ORIGIN}}) -- the export's origin: region coordinates + ORIGIN = world
local KEEP = {} -- names of workspace.World.Map children the real run leaves in place (empty by default)

local Stage = SS:FindFirstChild("RegionStaging")
if not Stage then return "finish: no ServerStorage.RegionStaging (run the chunks first)" end
local Dry = Stage:GetAttribute("DryRun") == true

-- what the staging holds
local function Groups()
	local L = {}
	for _, G in ipairs(Stage:GetChildren()) do
		if G.Name:sub(1, 1) ~= "_" then table.insert(L, G) end
	end
	return L
end

local function Check()
	local Bad = {}
	local Models, Parts, Tags, Lights = 0, 0, {}, 0
	local TagsByGroup = {}
	for _, G in ipairs(Groups()) do
		local WantM, WantP = EXPECTED.groups[G.Name], EXPECTED.groupParts[G.Name]
		if not WantM then table.insert(Bad, "unexpected group " .. G.Name) end
		local GM, GP = 0, 0
		for _, M in ipairs(G:GetChildren()) do
			GM += 1
			if not M:IsA("Model") or M:GetAttribute("RegionKit") ~= REGION then
				table.insert(Bad, G.Name .. "/" .. M.Name .. " has no RegionKit = " .. REGION)
			end
			for _, D in ipairs(M:GetDescendants()) do
				if D:IsA("BasePart") then
					GP += 1
					for _, T in ipairs(CS:GetTags(D)) do
						Tags[T] = (Tags[T] or 0) + 1
						TagsByGroup[T] = TagsByGroup[T] or {}
						TagsByGroup[T][G.Name] = (TagsByGroup[T][G.Name] or 0) + 1
					end
					if D.MaterialVariant ~= "" and not MS:FindFirstChild(D.MaterialVariant) then
						Bad[#Bad + 1] = D:GetFullName() .. " uses a missing MaterialVariant " .. D.MaterialVariant
					end
				elseif D:IsA("Light") then
					Lights += 1
				end
			end
		end
		if WantM and GM ~= WantM then table.insert(Bad, ("%s: %d models, expected %d"):format(G.Name, GM, WantM)) end
		if WantP and GP ~= WantP then table.insert(Bad, ("%s: %d parts, expected %d"):format(G.Name, GP, WantP)) end
		Models += GM
		Parts += GP
	end
	for Name in pairs(EXPECTED.groups) do
		if not Stage:FindFirstChild(Name) then table.insert(Bad, "missing group " .. Name) end
	end
	if Models ~= EXPECTED.models then table.insert(Bad, ("%d models, expected %d"):format(Models, EXPECTED.models)) end
	if Parts ~= EXPECTED.parts then table.insert(Bad, ("%d parts, expected %d"):format(Parts, EXPECTED.parts)) end
	if Lights ~= EXPECTED.lights then table.insert(Bad, ("%d lights, expected %d"):format(Lights, EXPECTED.lights)) end
	-- tags: every tag the export carries, per group (so RenseiNoGrip must sit on every Edges wall), and no others
	for T, N in pairs(EXPECTED.tags) do
		if (Tags[T] or 0) ~= N then table.insert(Bad, ("tag %s on %d parts, expected %d"):format(T, Tags[T] or 0, N)) end
		for G, GN in pairs(EXPECTED.tagsByGroup[T] or {}) do
			local Got = TagsByGroup[T] and TagsByGroup[T][G] or 0
			if Got ~= GN then table.insert(Bad, ("tag %s in %s on %d parts, expected %d"):format(T, G, Got, GN)) end
		end
	end
	for T, N in pairs(Tags) do
		if not EXPECTED.tags[T] then table.insert(Bad, ("tag %s on %d parts, expected none"):format(T, N)) end
	end
	-- the texture-pack MaterialVariants: each in MaterialService (a different one of the same name, kept there until
	-- the real run swaps it, also counts; its replacement waits in RegionStaging._Variants)
	for _, V in ipairs(EXPECTED.variants) do
		local Have = MS:FindFirstChild(V)
		if not (Have and Have:IsA("MaterialVariant")) then
			table.insert(Bad, "MaterialVariant " .. V .. " missing from MaterialService")
		end
	end
	return Bad, Models, Parts, Tags
end

local function TagText(Tags)
	local L = {}
	for T, N in pairs(Tags) do table.insert(L, T .. "=" .. N) end
	table.sort(L)
	return table.concat(L, " ")
end

local Bad, Models, Parts, Tags = Check()

if Dry then
	-- leave the place as it was: the variants this kit made, then the staging folder
	local Removed, Kept = 0, 0
	for _, V in ipairs(EXPECTED.variants) do
		local Have = MS:FindFirstChild(V)
		if Have and Have:GetAttribute("RegionKitStaged") == REGION then
			Have:Destroy()
			Removed += 1
		elseif Have then
			Kept += 1
		end
	end
	Stage:Destroy()
	local NG = 0
	for _ in pairs(EXPECTED.groups) do NG += 1 end
	local Text = ("%s: %d models, %d parts, %d groups; tags %s; variants %d/%d present (%d made by the kit and removed, %d kept); staging removed")
		:format(REGION, Models, Parts, NG, TagText(Tags), Removed + Kept, #EXPECTED.variants, Removed, Kept)
	if #Bad > 0 then return "dry run FAILED: " .. table.concat(Bad, "; ") .. " | " .. Text end
	return "dry run ok: " .. Text
end

-- the real run
if #Bad > 0 then return "finish refused (staging does not match expected.json): " .. table.concat(Bad, "; ") end
if PLACE_ID == 0 or game.PlaceId ~= PLACE_ID then
	return ("finish refused: this kit is for place %d, this is place %d (set DryRun to check it here)"):format(PLACE_ID, game.PlaceId)
end
local Backups = SS:FindFirstChild("RenseiBackups")
if not Backups then
	Backups = Instance.new("Folder")
	Backups.Name = "RenseiBackups"
	Backups.Parent = SS
end
local BName = "Pre-Region_" .. REGION .. "_" .. DATE
if Backups:FindFirstChild(BName) then return "finish refused: RenseiBackups." .. BName .. " exists (already swapped)" end
local World = workspace:FindFirstChild("World")
local Map = World and World:FindFirstChild("Map")
if not Map then return "finish refused: no workspace.World.Map" end

local B = Instance.new("Folder")
B.Name = BName
B.Parent = Backups
local BMap = Instance.new("Folder")
BMap.Name = "Map"
BMap.Parent = B
local Moved = 0
for _, C in ipairs(Map:GetChildren()) do
	if not table.find(KEEP, C.Name) then
		C.Parent = BMap
		Moved += 1
	end
end
-- MaterialVariants: a different one of the same name is backed up and replaced; the kit's own ones stay, unmarked
local Replaced = 0
local Wait = Stage:FindFirstChild("_Variants")
if Wait then
	local BVar = Instance.new("Folder")
	BVar.Name = "MaterialVariants"
	BVar.Parent = B
	for _, New in ipairs(Wait:GetChildren()) do
		local Old = MS:FindFirstChild(New.Name)
		if Old then Old.Parent = BVar end
		New.Parent = MS
		Replaced += 1
	end
end
for _, V in ipairs(EXPECTED.variants) do
	local Have = MS:FindFirstChild(V)
	if Have then Have:SetAttribute("RegionKitStaged", nil) end
end
local Dest = Instance.new("Model")
Dest.Name = REGION
for _, G in ipairs(Groups()) do G.Parent = Dest end
Dest.Parent = Map
Stage:Destroy()
-- terrain water from water.json
local Terrain = workspace.Terrain
for _, W in ipairs(WATER) do
	local R = W.Rect
	local Centre = ORIGIN + Vector3.new((R[1] + R[3]) / 2, (W.Top + W.Bed) / 2, (R[2] + R[4]) / 2)
	Terrain:FillBlock(CFrame.new(Centre), Vector3.new(R[3] - R[1], W.Top - W.Bed, R[4] - R[2]), Enum.Material.Water)
end
return ("finish: %s built into workspace.World.Map.%s (%d models, %d parts; tags %s); %d old Map children backed up to RenseiBackups.%s; %d MaterialVariants replaced (old ones backed up); %d water boxes filled")
	:format(REGION, REGION, Models, Parts, TagText(Tags), Moved, BName, Replaced, #WATER)
