-- generated by Art/Studio/Regions/kit.py from finish_region.lua.tmpl ({{GENERATED_TEXT}}): do not edit by hand.
-- Region {{REGION_TEXT}} (place {{PLACE_ID}}). Run in Studio Edit after import/chunk_NN.lua have built ServerStorage.RegionStaging.
-- Set ONE attribute on ServerStorage.RegionStaging first:
--   * DryRun = true: checks the staging against expected.json (models, parts, groups, tags per group, RegionKit,
--     lights, the texture-pack MaterialVariants and the parts that carry them), then removes the staging folder and
--     every MaterialVariant the chunks made (RegionKitStaged = Region), so the place is left as it was, even when a
--     check throws. Returns "dry run ok: ..." or "dry run FAILED: ...".
--   * Confirm = "<Region>": the real run, only in place {{PLACE_ID}}. With neither, it refuses and changes nothing.
-- The real run refuses, changing nothing, if: the checks fail; this is another place; today's backup
-- RenseiBackups["Pre-Region_<Region>_<run date>"] exists; workspace.World.Map is missing; a KEEP name is not a
-- World.Map child, or is the region's own name. Then, inside a pcall that rolls everything back on an error:
--   builds Map.<Region> (a Model) from the staged groups; creates the backup; moves every World.Map child not in
--   KEEP into it with its CollectionService tags stripped (kept as JSON in the attribute RegionKitTags, so services
--   reading GetTagged don't see the old map); backs up and swaps any MaterialVariant it replaces; snapshots the
--   terrain under each water box (TerrainRegion) and fills it with water; parents Map.<Region>. Returns a summary
--   naming what was moved and kept. import/restore.lua undoes it.
local HS = game:GetService("HttpService")
local SS = game:GetService("ServerStorage")
local MS = game:GetService("MaterialService")
local CS = game:GetService("CollectionService")

local REGION, PLACE_ID, GENERATED = {{REGION}}, {{PLACE_ID}}, {{GENERATED}}
local EXPECTED = HS:JSONDecode([==[{{EXPECTED}}]==])
local WATER = HS:JSONDecode([==[{{WATER}}]==]) -- {Rect = {x0, z0, x1, z1}, Top, Bed} in region coordinates
local ORIGIN = Vector3.new({{ORIGIN}}) -- the export's origin: region coordinates + ORIGIN = world
local KEEP = HS:JSONDecode([==[{{KEEP}}]==]) -- World.Map children the real run leaves in place (the region file's Keep)
local BNAME = "Pre-Region_" .. REGION .. "_" .. os.date("%Y-%m-%d") -- keyed on the run date
local LEFT = "nothing changed (ServerStorage.RegionStaging and the kit's MaterialVariants are left in place)"

local Stage = SS:FindFirstChild("RegionStaging")
if not Stage then return "finish: no ServerStorage.RegionStaging (run the chunks first); nothing changed" end
local Dry = Stage:GetAttribute("DryRun") == true
local Confirm = Stage:GetAttribute("Confirm")

-- the staged groups (RegionStaging._Variants holds replacement MaterialVariants, not a group)
local function Groups()
	local L = {}
	for _, G in ipairs(Stage:GetChildren()) do
		if G.Name:sub(1, 1) ~= "_" then table.insert(L, G) end
	end
	return L
end

local function Check()
	local Bad = {}
	local Models, Parts, Tags, Lights = 0, 0, {}, 0
	local TagsByGroup, VarParts = {}, {}
	for _, G in ipairs(Groups()) do
		local WantM, WantP = EXPECTED.groups[G.Name], EXPECTED.groupParts[G.Name]
		if not WantM then table.insert(Bad, "unexpected group " .. G.Name) end
		local GM, GP = 0, 0
		for _, M in ipairs(G:GetChildren()) do
			GM += 1
			if not M:IsA("Model") or M:GetAttribute("RegionKit") ~= REGION then
				table.insert(Bad, G.Name .. "/" .. M.Name .. " has no RegionKit = " .. REGION)
			end
			for _, D in ipairs(M:GetDescendants()) do
				if D:IsA("BasePart") then
					GP += 1
					for _, T in ipairs(CS:GetTags(D)) do
						Tags[T] = (Tags[T] or 0) + 1
						TagsByGroup[T] = TagsByGroup[T] or {}
						TagsByGroup[T][G.Name] = (TagsByGroup[T][G.Name] or 0) + 1
					end
					if D.MaterialVariant ~= "" then
						VarParts[D.MaterialVariant] = (VarParts[D.MaterialVariant] or 0) + 1
						if not MS:FindFirstChild(D.MaterialVariant) then
							table.insert(Bad, D:GetFullName() .. " uses a missing MaterialVariant " .. D.MaterialVariant)
						end
					end
				elseif D:IsA("Light") then
					Lights += 1
				end
			end
		end
		if WantM and GM ~= WantM then table.insert(Bad, ("%s: %d models, expected %d"):format(G.Name, GM, WantM)) end
		if WantP and GP ~= WantP then table.insert(Bad, ("%s: %d parts, expected %d"):format(G.Name, GP, WantP)) end
		Models += GM
		Parts += GP
	end
	for Name in pairs(EXPECTED.groups) do
		if not Stage:FindFirstChild(Name) then table.insert(Bad, "missing group " .. Name) end
	end
	if Models ~= EXPECTED.models then table.insert(Bad, ("%d models, expected %d"):format(Models, EXPECTED.models)) end
	if Parts ~= EXPECTED.parts then table.insert(Bad, ("%d parts, expected %d"):format(Parts, EXPECTED.parts)) end
	if Lights ~= EXPECTED.lights then table.insert(Bad, ("%d lights, expected %d"):format(Lights, EXPECTED.lights)) end
	-- tags: every tag the export carries, per group (so RenseiNoGrip must sit on every Edges wall), and no others
	for T, N in pairs(EXPECTED.tags) do
		if (Tags[T] or 0) ~= N then table.insert(Bad, ("tag %s on %d parts, expected %d"):format(T, Tags[T] or 0, N)) end
		for G, GN in pairs(EXPECTED.tagsByGroup[T] or {}) do
			local Got = TagsByGroup[T] and TagsByGroup[T][G] or 0
			if Got ~= GN then table.insert(Bad, ("tag %s in %s on %d parts, expected %d"):format(T, G, Got, GN)) end
		end
	end
	for T, N in pairs(Tags) do
		if not EXPECTED.tags[T] then table.insert(Bad, ("tag %s on %d parts, expected none"):format(T, N)) end
	end
	-- the texture-pack MaterialVariants: each in MaterialService (a different one of the same name, kept there until
	-- the real run swaps it, also counts; its replacement waits in RegionStaging._Variants), and on exactly the parts
	-- of its material
	for _, V in ipairs(EXPECTED.variants) do
		local Have = MS:FindFirstChild(V)
		if not (Have and Have:IsA("MaterialVariant")) then
			table.insert(Bad, "MaterialVariant " .. V .. " missing from MaterialService")
		end
		local Want = EXPECTED.variantParts[V] or 0
		if (VarParts[V] or 0) ~= Want then
			table.insert(Bad, ("MaterialVariant %s on %d parts, expected %d"):format(V, VarParts[V] or 0, Want))
		end
	end
	for V, N in pairs(VarParts) do
		if not table.find(EXPECTED.variants, V) then
			table.insert(Bad, ("MaterialVariant %s on %d parts, expected none"):format(V, N))
		end
	end
	return Bad, Models, Parts, Tags
end

local function TagText(Tags)
	local L = {}
	for T, N in pairs(Tags or {}) do table.insert(L, T .. "=" .. N) end
	table.sort(L)
	return table.concat(L, " ")
end

if Dry then
	local Ok, Bad, Models, Parts, Tags = pcall(Check)
	-- always leave the place as it was: the variants this kit made, then the staging folder
	local Removed, Kept = 0, 0
	for _, V in ipairs(EXPECTED.variants) do
		local Have = MS:FindFirstChild(V)
		if Have and Have:GetAttribute("RegionKitStaged") == REGION then
			Have:Destroy()
			Removed += 1
		elseif Have then
			Kept += 1
		end
	end
	Stage:Destroy()
	local Tail = ("variants %d/%d present (%d made by the kit and removed, %d kept); staging removed")
		:format(Removed + Kept, #EXPECTED.variants, Removed, Kept)
	if not Ok then return "dry run FAILED: the check threw: " .. tostring(Bad) .. " | " .. Tail end
	local NG = 0
	for _ in pairs(EXPECTED.groups) do NG += 1 end
	local Text = ("%s: %d models, %d parts, %d groups; tags %s; %s"):format(REGION, Models, Parts, NG, TagText(Tags), Tail)
	if #Bad > 0 then return "dry run FAILED: " .. table.concat(Bad, "; ") .. " | " .. Text end
	return "dry run ok: " .. Text
end

-- the real run: every refusal comes before the first change
if Confirm ~= REGION then
	return ('finish refused: set the RegionStaging attribute DryRun = true to check, or Confirm = "%s" for the real run; %s')
		:format(REGION, LEFT)
end
local Ok, Bad, Models, Parts, Tags = pcall(Check)
if not Ok then return "finish refused: the check threw: " .. tostring(Bad) .. "; " .. LEFT end
if #Bad > 0 then return "finish refused (staging does not match expected.json): " .. table.concat(Bad, "; ") .. "; " .. LEFT end
if PLACE_ID == 0 or game.PlaceId ~= PLACE_ID then
	return ("finish refused: this kit is for place %d, this is place %d (set DryRun to check it here); %s"):format(PLACE_ID, game.PlaceId, LEFT)
end
local Backups = SS:FindFirstChild("RenseiBackups")
if Backups and Backups:FindFirstChild(BNAME) then
	return "finish refused: RenseiBackups." .. BNAME .. " exists (already swapped today; run restore.lua first); " .. LEFT
end
local World = workspace:FindFirstChild("World")
local Map = World and World:FindFirstChild("Map")
if not Map then return "finish refused: no workspace.World.Map; " .. LEFT end
local Missing = {}
for _, N in ipairs(KEEP) do
	if N == REGION then return "finish refused: KEEP names the region itself (" .. REGION .. "); " .. LEFT end
	if not Map:FindFirstChild(N) then table.insert(Missing, N) end
end
if #Missing > 0 then
	return "finish refused: KEEP names not found under World.Map: " .. table.concat(Missing, ", ") .. "; " .. LEFT
end

local Terrain = workspace.Terrain
local Journal, Stripped, Added, Snaps, Moved, Kept = {}, {}, {}, {}, {}, {}
local B, Dest, MadeBackups
local function Move(I, To)
	table.insert(Journal, {I, I.Parent})
	I.Parent = To
end
local function StripOne(D)
	local T = CS:GetTags(D)
	if #T > 0 then
		D:SetAttribute("RegionKitTags", HS:JSONEncode(T))
		for _, Tag in ipairs(T) do CS:RemoveTag(D, Tag) end
		table.insert(Stripped, D)
	end
end
local function Strip(Root)
	StripOne(Root)
	for _, D in ipairs(Root:GetDescendants()) do StripOne(D) end
end
local function Folder(Name, Parent)
	local F = Instance.new("Folder")
	F.Name = Name
	F.Parent = Parent
	return F
end

local function Swap()
	Dest = Instance.new("Model") -- built outside the Map first
	Dest.Name = REGION
	Dest:SetAttribute("RegionKit", REGION)
	Dest:SetAttribute("RegionKitBackup", BNAME)
	for _, G in ipairs(Groups()) do Move(G, Dest) end
	if not Backups then
		Backups = Folder("RenseiBackups", nil)
		MadeBackups = true
		Backups.Parent = SS
	end
	B = Instance.new("Folder")
	B.Name = BNAME
	B:SetAttribute("RegionKitRegion", REGION)
	B:SetAttribute("CreatedRenseiBackups", MadeBackups == true)
	B.Parent = Backups
	local BMap = Folder("Map", B)
	for _, C in ipairs(Map:GetChildren()) do
		if table.find(KEEP, C.Name) then
			table.insert(Kept, C.Name)
		else
			Strip(C)
			Move(C, BMap)
			table.insert(Moved, C.Name)
		end
	end
	local Wait = Stage:FindFirstChild("_Variants")
	if Wait then
		local BVar = Folder("MaterialVariants", B)
		for _, New in ipairs(Wait:GetChildren()) do
			local Old = MS:FindFirstChild(New.Name)
			if Old then
				Strip(Old)
				Move(Old, BVar)
			end
			Move(New, MS)
		end
	end
	for _, V in ipairs(EXPECTED.variants) do -- the kit's variants now belong to the place; restore.lua removes them
		local Have = MS:FindFirstChild(V)
		if Have and Have:GetAttribute("RegionKitStaged") == REGION then
			table.insert(Added, V)
			Have:SetAttribute("RegionKitStaged", nil)
		end
	end
	-- water: snapshot the terrain under each box first (restore pastes it back), then fill
	local WF = Folder("Water", B)
	local Boxes = {}
	for I, W in ipairs(WATER) do
		local R = W.Rect
		local Lo = ORIGIN + Vector3.new(R[1], W.Bed, R[2])
		local Hi = ORIGIN + Vector3.new(R[3], W.Top, R[4])
		local VLo = Vector3int16.new(math.floor(Lo.X / 4), math.floor(Lo.Y / 4), math.floor(Lo.Z / 4))
		local VHi = Vector3int16.new(math.ceil(Hi.X / 4) - 1, math.ceil(Hi.Y / 4) - 1, math.ceil(Hi.Z / 4) - 1)
		local Snap = Terrain:CopyRegion(Region3int16.new(VLo, VHi))
		Snap.Name = "Box" .. I
		Snap:SetAttribute("Corner", Vector3.new(VLo.X, VLo.Y, VLo.Z))
		Snap.Parent = WF
		table.insert(Snaps, Snap)
		Terrain:FillBlock(CFrame.new((Lo + Hi) / 2), Hi - Lo, Enum.Material.Water)
		table.insert(Boxes, {Lo.X, Lo.Y, Lo.Z, Hi.X, Hi.Y, Hi.Z})
	end
	B:SetAttribute("WaterBoxes", HS:JSONEncode(Boxes))
	B:SetAttribute("Moved", HS:JSONEncode(Moved))
	B:SetAttribute("Kept", HS:JSONEncode(Kept))
	B:SetAttribute("VariantsAdded", HS:JSONEncode(Added))
	Move(Dest, Map)
end

local SOk, SErr = pcall(Swap)
if not SOk then
	local ROk, RErr = pcall(function()
		for I = #Snaps, 1, -1 do
			local C = Snaps[I]:GetAttribute("Corner")
			Terrain:PasteRegion(Snaps[I], Vector3int16.new(C.X, C.Y, C.Z), true)
		end
		for I = #Journal, 1, -1 do Journal[I][1].Parent = Journal[I][2] end
		for _, D in ipairs(Stripped) do
			for _, Tag in ipairs(HS:JSONDecode(D:GetAttribute("RegionKitTags"))) do CS:AddTag(D, Tag) end
			D:SetAttribute("RegionKitTags", nil)
		end
		for _, V in ipairs(Added) do
			local Have = MS:FindFirstChild(V)
			if Have then Have:SetAttribute("RegionKitStaged", REGION) end
		end
		if B then B:Destroy() end
		if MadeBackups and Backups then Backups:Destroy() end
		if Dest then Dest:Destroy() end
	end)
	if not ROk then
		return "finish FAILED (" .. tostring(SErr) .. ") AND ITS ROLLBACK FAILED (" .. tostring(RErr)
			.. "): restore by hand from RenseiBackups." .. BNAME
	end
	return "finish FAILED and rolled back: " .. tostring(SErr) .. "; World.Map, MaterialService and terrain are as they were; " .. LEFT
end
Stage:Destroy()
return ("finish: %s built into workspace.World.Map.%s (%d models, %d parts; tags %s); moved to RenseiBackups.%s: %s; kept: %s; %d tagged instances stripped; MaterialVariants added %s; %d water boxes filled (terrain snapshots in the backup); undo with import/restore.lua")
	:format(REGION, REGION, Models, Parts, TagText(Tags), BNAME, #Moved > 0 and table.concat(Moved, ", ") or "nothing",
		#Kept > 0 and table.concat(Kept, ", ") or "nothing", #Stripped, #Added > 0 and table.concat(Added, ", ") or "none", #WATER)
