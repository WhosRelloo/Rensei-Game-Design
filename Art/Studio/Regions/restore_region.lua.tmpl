-- generated by Art/Studio/Regions/kit.py from restore_region.lua.tmpl ({{GENERATED_TEXT}}): do not edit by hand.
-- Region {{REGION_TEXT}}: undoes finish.lua's real run, in Studio Edit. It uses the newest
-- ServerStorage.RenseiBackups["Pre-Region_<Region>_<date>"] that finish.lua made (set DATE below to pick another), and
-- refuses, changing nothing, if there is none, if workspace.World.Map is missing, or if the Map.<Region> that backup
-- made is gone. Then: removes Map.<Region>; moves the backed-up Map children back into World.Map and re-adds their
-- CollectionService tags (from RegionKitTags); removes the MaterialVariants the run added and puts back the ones it
-- replaced; pastes back the terrain under the water boxes; removes the backup folder (and RenseiBackups, if finish.lua
-- made it and it is now empty).
local HS = game:GetService("HttpService")
local SS = game:GetService("ServerStorage")
local MS = game:GetService("MaterialService")
local CS = game:GetService("CollectionService")

local REGION = {{REGION}}
local DATE = nil -- e.g. "2026-10-24" to restore that day's backup; nil = the newest

local Backups = SS:FindFirstChild("RenseiBackups")
local Prefix = "Pre-Region_" .. REGION .. "_"
local B
for _, C in ipairs(Backups and Backups:GetChildren() or {}) do
	if C.Name:sub(1, #Prefix) == Prefix and C:GetAttribute("RegionKitRegion") == REGION
		and (DATE == nil or C.Name == Prefix .. DATE) and (B == nil or C.Name > B.Name) then
		B = C
	end
end
if not B then return "restore refused: no RenseiBackups." .. Prefix .. (DATE or "<date>") .. " made by finish.lua; nothing changed" end
local World = workspace:FindFirstChild("World")
local Map = World and World:FindFirstChild("Map")
if not Map then return "restore refused: no workspace.World.Map; nothing changed" end
local Dest
for _, C in ipairs(Map:GetChildren()) do
	if C.Name == REGION and C:GetAttribute("RegionKitBackup") == B.Name then Dest = C end
end
if not Dest then
	return "restore refused: World.Map." .. REGION .. " made with backup " .. B.Name .. " is not there; nothing changed"
end

local function Unstrip(D)
	local J = D:GetAttribute("RegionKitTags")
	if J then
		for _, Tag in ipairs(HS:JSONDecode(J)) do CS:AddTag(D, Tag) end
		D:SetAttribute("RegionKitTags", nil)
		return 1
	end
	return 0
end
local function UnstripAll(Root)
	local N = Unstrip(Root)
	for _, D in ipairs(Root:GetDescendants()) do N += Unstrip(D) end
	return N
end

local Back, Tagged, VarsRemoved, VarsBack, Pasted = {}, 0, 0, 0, 0
local Ok, Res = pcall(function()
	Dest:Destroy()
	local BMap = B:FindFirstChild("Map")
	for _, C in ipairs(BMap and BMap:GetChildren() or {}) do
		C.Parent = Map
		Tagged += UnstripAll(C)
		table.insert(Back, C.Name)
	end
	for _, V in ipairs(HS:JSONDecode(B:GetAttribute("VariantsAdded") or "[]")) do
		local Have = MS:FindFirstChild(V)
		if Have then
			Have:Destroy()
			VarsRemoved += 1
		end
	end
	local BVar = B:FindFirstChild("MaterialVariants")
	for _, Old in ipairs(BVar and BVar:GetChildren() or {}) do
		Old.Parent = MS
		Tagged += UnstripAll(Old)
		VarsBack += 1
	end
	local WF = B:FindFirstChild("Water")
	local Snaps = WF and WF:GetChildren() or {}
	table.sort(Snaps, function(A, Z) return (tonumber(A.Name:sub(4)) or 0) > (tonumber(Z.Name:sub(4)) or 0) end) -- the reverse of the fill order
	for _, Snap in ipairs(Snaps) do
		local C = Snap:GetAttribute("Corner")
		workspace.Terrain:PasteRegion(Snap, Vector3int16.new(C.X, C.Y, C.Z), true)
		Pasted += 1
	end
	local MadeBackups = B:GetAttribute("CreatedRenseiBackups") == true
	local BName = B.Name
	B:Destroy()
	if MadeBackups and #Backups:GetChildren() == 0 then Backups:Destroy() end
	return BName
end)
if not Ok then
	return "restore FAILED part way (" .. tostring(Res) .. "): finish the rest by hand from RenseiBackups." .. B.Name
end
return ("restore: %s removed; back in World.Map: %s; %d tagged instances re-tagged; MaterialVariants removed %d, put back %d; %d terrain snapshots pasted; backup %s removed")
	:format(REGION, #Back > 0 and table.concat(Back, ", ") or "nothing", Tagged, VarsRemoved, VarsBack, Pasted, Res)
